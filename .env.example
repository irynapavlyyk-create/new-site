# Anthropic Claude API
# Получить на https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Stripe
# Получить на https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# Stripe webhook signing secret (для /api/webhook)
# Получить на https://dashboard.stripe.com/webhooks после создания endpoint
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# Feature flags. Coach (monthly subscription) is off sale by default — see docs/backlog.md.
NEXT_PUBLIC_COACH_ENABLED=false

# Stripe Price IDs (создаются в Stripe Dashboard → Products)
STRIPE_PRICE_PRO=YOUR_PRO_PRICE_ID_HERE
STRIPE_PRICE_COACH=YOUR_COACH_PRICE_ID_HERE

# Launch-promo Price IDs (50% off; used while the promo window is open — see src/lib/promo.ts)
STRIPE_PRICE_PRO_PROMO=YOUR_PRO_PROMO_PRICE_ID_HERE
STRIPE_PRICE_COACH_PROMO=YOUR_COACH_PROMO_PRICE_ID_HERE

# Resend — транзакционные письма (magic link идёт через Supabase SMTP, остальное
# через SDK) и email-алерты paid path (src/lib/alerts.ts).
# Получить на https://resend.com/api-keys. В проде задан в Vercel; локально без
# ключа письма и алерты только логируются (алерты при этом дублируются в Sentry).
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# Куда шлются алерты paid path. Необязательно: если не задана, действует дефолт
# support@energyforge.app (см. ALERT_TO в src/lib/alerts.ts).
ALERT_EMAIL_TO=support@energyforge.app

# Публичный базовый URL сайта (для Stripe success/cancel URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta (Facebook) Pixel ID. Leave empty to disable the pixel.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
